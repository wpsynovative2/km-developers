# Public site URL, used for social sharing images
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Google Apps Script web app URL (Deploy → New deployment → Web app → copy URL)
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec

# Optional: must match the SHARED_SECRET Script Property in Apps Script
GOOGLE_SCRIPT_SECRET=
